# Base URL of the MyFitnessLog backend REST API, including the /api/v1 prefix.
#
# Copy this file to `.env.local` and adjust for your machine. Vite only exposes
# variables prefixed with VITE_ to client code. There is no hardcoded fallback
# in source — a missing value fails fast at startup (see src/config/env.ts),
# mirroring the Android client's configurable `apiBaseUrl` (M9.5 T3).
VITE_API_BASE_URL=http://localhost:8080/api/v1
