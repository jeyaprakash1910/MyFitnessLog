# macOS
.DS_Store

# IntelliJ IDEA
.idea/
*.iml

# VS Code. Personal settings stay local, but settings.json ships: it carries the
# TD-016 fix (java.autobuild.enabled), without which the backend test suite fails
# in the working copy for anyone using the Red Hat Java extension.
.vscode/*
!.vscode/settings.json

# Environment
.env
.env.*
# ...but the example must ship: VITE_API_BASE_URL has no default, so without a
# committed template the web app cannot be configured from a fresh clone.
!.env.example
!.env.prod.example

# Logs
*.log

# Node
node_modules/

# React
dist/
build/

# Gradle
.gradle/
build/

# Android
local.properties
captures/
*.apk
*.aab

# Signing material. The keystore IS the app's identity: committing it cannot be
# undone by rotation, because Android refuses an update signed by a different
# key. Keep it and its credentials outside the repository entirely
# (docs/RELEASE_CHECKLIST.md).
*.jks
*.keystore
keystore.properties

# Kotlin
*.class

# Java
target/
out/

# Maven
.mvn/wrapper/maven-wrapper.jar

# OS
Thumbs.db

# Developer-only implementation journals (not part of project documentation)
docs/internal/
