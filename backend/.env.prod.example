# Production environment variables (template — NO real secrets in this file).
# Copy the real values into Render's Environment settings, not into git.
# Activated by SPRING_PROFILES_ACTIVE=prod (see application-prod.yml).

# --- Profile ---
SPRING_PROFILES_ACTIVE=prod

# --- Runtime datasource: Supabase TRANSACTION pooler (Supavisor, port 6543) ---
# Copy from Supabase: Project Settings -> Database -> Connection string ("Transaction").
SPRING_DATASOURCE_URL=jdbc:postgresql://<pooler-host>:6543/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
SPRING_DATASOURCE_PASSWORD=<db-password>
# Optional: raise only if you ever scale beyond one user. Default is 3.
# DB_POOL_MAX_SIZE=3

# --- Flyway datasource: Supabase SESSION pooler (port 5432) ---
# Same host family, port 5432 ("Session" connection string). Advisory-lock safe.
FLYWAY_URL=jdbc:postgresql://<pooler-host>:5432/postgres?sslmode=require
FLYWAY_USER=postgres.<project-ref>
FLYWAY_PASSWORD=<db-password>

# --- Web (CORS): the deployed Vercel origin(s), comma-separated ---
# Inherited from application.yml's app.cors.allowed-origins key.
WEB_ALLOWED_ORIGINS=https://<your-app>.vercel.app

# --- API-key authentication (REQUIRED in production) ---
# The shared secret checked against the X-API-Key header on every request (ADR-0013).
# When set, the API is default-deny: only /api/v1/health and correctly-keyed requests
# pass. Under the 'prod' profile the app REFUSES TO START if this is blank (fail-fast;
# SecurityConfig / ADR-0013) — a production backend can never run with authentication
# disabled by omission. Only the non-prod (dev/test) profiles treat a blank key as
# "auth disabled" for local convenience.
# Use a long random value; store it in the client's config too (Android apiKey).
APP_API_KEY=<long-random-secret>
