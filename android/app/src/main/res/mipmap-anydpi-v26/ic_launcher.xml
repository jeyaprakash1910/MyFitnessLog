<?xml version="1.0" encoding="utf-8"?>
<!--
    The adaptive launcher icon (API 26+).

    minSdk is 26, so every device this app runs on uses this file rather than the
    legacy bitmap. Without it Android masks the legacy icon itself, which shrinks
    the artwork inside a plate and is why a legacy-only icon looks smaller and
    flatter on the launcher than it does in the source file.

    The foreground carries only the mark, on transparency: the launcher supplies
    the shape, and the background layer supplies the colour. The mark is sized to
    52% of the 108dp canvas, inside the 66dp safe zone, so no launcher mask - circle,
    squircle, teardrop - can clip it.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
