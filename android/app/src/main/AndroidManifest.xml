<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required for backend synchronization. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        In-app updates (ADR-0016). The app is distributed as an APK outside any
        store, so it must be able to ask the system installer to install the build
        it downloaded. This permission only allows *asking*: the platform still
        shows its own confirmation, and the user must separately have granted this
        app "install unknown apps" in system settings, which nothing here can
        bypass.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".MyFitnessLogApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyFitnessLog">

        <!--
            Remove WorkManager's default startup initializer so the Application's
            Configuration.Provider is used instead. Without this, WorkManager
            initializes at content-provider time with the default worker factory,
            which cannot construct @HiltWorker classes — SyncWorker would then
            fail to instantiate at runtime.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!--
            Exposes the downloaded APK to the system package installer, which runs
            in another process and cannot read this app's private cache directly.
            A `file://` URI across a process boundary has been rejected since
            Android 7, so a FileProvider is the only way to grant that read.

            Not exported, and grantUriPermissions means access is granted per
            intent and expires with it, so the file is readable by the installer for
            the duration of the install and by nothing else.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MyFitnessLog">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
