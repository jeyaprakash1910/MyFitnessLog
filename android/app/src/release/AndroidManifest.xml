<?xml version="1.0" encoding="utf-8"?>
<!--
    Release-only manifest overlay.

    Points the release build at the network security config generated by
    :app:generateReleaseNetworkSecurityConfig, which permits cleartext to the
    single host named by `apiBaseUrl` and forbids it everywhere else.

    This exists because Version 1 is a local production release (Option B): the
    backend is reached over plain HTTP on the LAN. It is deliberately narrower
    than the debug config, which permits cleartext to any host — acceptable for
    a build that is never distributed, not for one that is.

    When the backend moves behind TLS the generated file stops granting any
    exemption on its own, so this overlay can stay exactly as it is.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:networkSecurityConfig="@xml/network_security_config" />

</manifest>
